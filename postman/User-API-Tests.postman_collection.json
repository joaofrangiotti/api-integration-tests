{
  "info": {
    "name": "User API Tests - Local Spring",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST - Criar usuario valido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Usuario Teste\",\n  \"email\": \"usuario.teste@email.com\",\n  \"senha\": \"123456\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/users",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "users"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "const body = pm.response.json();",
              "pm.environment.set('userId', body.id);",
              "pm.test('JSON com campos esperados', function () {",
              "  pm.expect(body).to.have.property('id');",
              "  pm.expect(body).to.have.property('nome');",
              "  pm.expect(body).to.have.property('email');",
              "  pm.expect(body).to.have.property('senha');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET - Listar usuarios",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/users",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "users"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna array', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(Array.isArray(body)).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "GET - Buscar usuario existente",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/users/{{userId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "users", "{{userId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Tem id e email', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('id');",
              "  pm.expect(body).to.have.property('email');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "PUT - Atualizar usuario",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Usuario Atualizado\",\n  \"email\": \"usuario.atualizado@email.com\",\n  \"senha\": \"654321\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/users/{{userId}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "users", "{{userId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna nome atualizado', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.nome).to.eql('Usuario Atualizado');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
