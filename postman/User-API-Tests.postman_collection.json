      ]
    },
    {
      "name": "GET - Usuario inexistente",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:8080/api/users/999999",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "users", "999999"]
